<?xml version="1.0" encoding="utf-8"?>
<!-- 统一弹窗基座：圆角卡片 + 标题 + 正文 + 可选输入/列表 + 按钮区（按钮由 AppDialog 动态生成） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardBackgroundColor="@color/home_card"
        app:cardCornerRadius="@dimen/corner_card"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/home_text_primary" />

            <TextView
                android:id="@+id/tv_card_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14sp"
                android:textColor="@color/home_text_secondary"
                android:lineSpacingExtra="4dp" />

            <EditText
                android:id="@+id/et_card_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_budget_option_normal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="15sp"
                android:textColor="@color/home_text_primary"
                android:textColorHint="@color/home_text_secondary"
                android:singleLine="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_card_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_card_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
