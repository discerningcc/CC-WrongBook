<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/edit_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 顶栏卡片：左取消，中标题，右完成 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_edit_header">

        <LinearLayout
            android:id="@+id/edit_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="取消"
                android:src="@drawable/ic_edit_close"
                android:tint="@color/detail_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.02"
                android:text="取消"
                android:textColor="@color/detail_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="编辑图片"
            android:textColor="@color/detail_text_primary"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/edit_done"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="完成"
                android:src="@drawable/ic_edit_check"
                android:tint="@color/detail_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.02"
                android:text="完成"
                android:textColor="@color/detail_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 舞台：深色圆角卡，图片按 FIT 显示，裁剪浮层叠在上面 -->
    <FrameLayout
        android:id="@+id/edit_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_edit_stage"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/edit_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="matrix" />

        <com.example.demo.CropOverlayView
            android:id="@+id/crop_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/edit_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/action_primary" />
    </FrameLayout>

    <!-- 编辑工具条：旋转两个方向 + 裁剪（裁剪会按设置自动去白边） -->
    <LinearLayout
        android:id="@+id/edit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/act_rotate_left"
            style="@style/ImageEditBarButton"
            android:background="@drawable/bg_detail_outline_gray">

            <ImageView
                style="@style/ImageEditBarIcon"
                android:contentDescription="左转"
                android:src="@drawable/ic_edit_rotate_left"
                android:tint="@color/detail_text_secondary" />

            <TextView
                style="@style/ImageEditBarText"
                android:text="左转"
                android:textColor="@color/detail_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/act_rotate_right"
            style="@style/ImageEditBarButton"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_detail_outline_gray">

            <ImageView
                style="@style/ImageEditBarIcon"
                android:contentDescription="右转"
                android:src="@drawable/ic_edit_rotate_right"
                android:tint="@color/detail_text_secondary" />

            <TextView
                style="@style/ImageEditBarText"
                android:text="右转"
                android:textColor="@color/detail_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/act_crop"
            style="@style/ImageEditBarButton"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_detail_primary">

            <ImageView
                style="@style/ImageEditBarIcon"
                android:contentDescription="裁剪"
                android:src="@drawable/ic_edit_crop"
                android:tint="@android:color/white" />

            <TextView
                style="@style/ImageEditBarText"
                android:text="裁剪"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- 裁剪工具条：重置选框 / 退出裁剪 / 确认裁剪 -->
    <LinearLayout
        android:id="@+id/crop_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/act_crop_reset"
            style="@style/ImageEditBarButton"
            android:background="@drawable/bg_detail_outline_gray">

            <ImageView
                style="@style/ImageEditBarIcon"
                android:contentDescription="重置"
                android:src="@drawable/ic_edit_reset"
                android:tint="@color/detail_text_secondary" />

            <TextView
                style="@style/ImageEditBarText"
                android:text="重置"
                android:textColor="@color/detail_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/act_crop_cancel"
            style="@style/ImageEditBarButton"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_detail_outline_gray">

            <ImageView
                style="@style/ImageEditBarIcon"
                android:contentDescription="取消裁剪"
                android:src="@drawable/ic_edit_close"
                android:tint="@color/detail_text_secondary" />

            <TextView
                style="@style/ImageEditBarText"
                android:text="取消裁剪"
                android:textColor="@color/detail_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/act_crop_confirm"
            style="@style/ImageEditBarButton"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_detail_primary">

            <ImageView
                style="@style/ImageEditBarIcon"
                android:contentDescription="确定"
                android:src="@drawable/ic_edit_check"
                android:tint="@android:color/white" />

            <TextView
                style="@style/ImageEditBarText"
                android:text="确定"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
