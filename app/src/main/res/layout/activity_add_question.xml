<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <!-- 标题栏：返回 + 居中标题 -->
    <LinearLayout style="@style/TopBar">

        <TextView
            android:id="@+id/btn_back"
            style="@style/TopBarBack" />

        <TextView
            android:id="@+id/title_bar"
            style="@style/TopBarTitle"
            android:text="添加题目" />

        <View
            android:layout_width="56dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 题目内容 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="题目内容"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_content_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/9"
                    android:textSize="14sp"
                    android:textColor="#999999" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_content"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="#fff"
                android:padding="14dp"
                android:minHeight="120dp"
                android:hint="输入题目，可拍照/截图后从相册添加"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <!-- 题目图片网格 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_content_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />

            <!-- 添加题目图片：整条点进相册，最右侧图标单独点进相机 -->
            <FrameLayout
                android:id="@+id/btn_add_content_img"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_add_button"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="添加题目图片"
                    android:textColor="#1f6aa5"
                    android:gravity="center" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="52dp"
                    android:background="#d5dbe4" />

                <ImageView
                    android:id="@+id/btn_camera_content"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:src="@drawable/ic_camera"
                    android:scaleType="centerInside"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="拍照添加题目图片" />
            </FrameLayout>

            <!-- 答案内容 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="答案内容"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_answer_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/9"
                    android:textSize="14sp"
                    android:textColor="#999999" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_answer"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="#fff"
                android:padding="14dp"
                android:minHeight="120dp"
                android:hint="输入答案，可拍照/截图后从相册添加"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <!-- 答案图片网格 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_answer_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />

            <!-- 添加答案图片：整条点进相册，最右侧图标单独点进相机 -->
            <FrameLayout
                android:id="@+id/btn_add_answer_img"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_add_button"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="添加答案图片"
                    android:textColor="#1f6aa5"
                    android:gravity="center" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="52dp"
                    android:background="#d5dbe4" />

                <ImageView
                    android:id="@+id/btn_camera_answer"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:src="@drawable/ic_camera"
                    android:scaleType="centerInside"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="拍照添加答案图片" />
            </FrameLayout>

            <!-- 保存按钮：主操作 + 保存并继续（仅新增态显示） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/btn_save_continue"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/bg_add_button"
                    android:text="保存并继续"
                    android:textColor="@color/action_primary"
                    android:gravity="center" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/corner_card"
                    app:cardBackgroundColor="@color/action_primary">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="保存题目"
                        android:textSize="18sp"
                        android:textColor="#fff"
                        android:gravity="center" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
