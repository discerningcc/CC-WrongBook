<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <!-- 标题栏 -->
    <LinearLayout style="@style/TopBar">

        <TextView
            android:id="@+id/btn_back"
            style="@style/TopBarBack" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="题库管理"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/btn_new_bank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:text="新建"
            android:textSize="@dimen/text_size_emphasis"
            android:textColor="@color/detail_primary"/>

        <TextView
            android:id="@+id/btn_import_bank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:text="导入"
            android:textSize="@dimen/text_size_emphasis"
            android:textColor="@color/detail_primary"/>

        <TextView
            android:id="@+id/btn_export_bank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginEnd="16dp"
            android:text="导出"
            android:textSize="@dimen/text_size_emphasis"
            android:textColor="@color/detail_primary"/>
    </LinearLayout>

    <!-- 操作提示 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="点击题库切换使用；长按题库可重命名 / 导出 / 删除"
        android:textSize="@dimen/text_size_caption"
        android:textColor="@color/text_hint"/>

    <!-- 题库列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_banks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="20dp"/>

</LinearLayout>
