<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.demo">

    <!-- 不声明存储权限：取图走系统文件选择器（SAF），保存相册走 MediaStore（Android 10+ 免权限）
         刻意不声明 CAMERA：拍照走系统相机，权限归相机应用；一旦声明，调用方反而要先申请到该权限 -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Demo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 复习界面 -->
        <activity
            android:name=".ReviewActivity"
            android:exported="false" />

        <!-- 复习记录 -->
        <activity
            android:name=".ReviewHistoryActivity"
            android:exported="false" />

        <!-- 添加题目界面 -->
        <activity
            android:name=".AddQuestionActivity"
            android:exported="false" />
        <activity android:name=".QuestionBankActivity" />
        <activity android:name=".QuestionDetailActivity" />
        <activity android:name=".SettingsActivity" />
        <activity android:name=".CheckinCalendarActivity" android:exported="false" />
        <activity android:name=".SaveManageActivity" />

        <!-- 图片编辑（旋转 / 裁剪）：只从应用内的图片长按菜单进入，不对外导出 -->
        <activity
            android:name=".ImageEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Demo.ImageEdit" />

        <!-- 拍照临时文件：只暴露缓存目录下的 camera/，供系统相机按 Uri 写入 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>