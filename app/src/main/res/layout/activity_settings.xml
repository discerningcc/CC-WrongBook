<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="top|center_horizontal">

    <Switch
        android:id="@+id/switch_natural_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="自然日模式（0点算新一天）"
        android:textSize="18sp"
        android:layout_marginTop="30dp"
        android:thumbTint="@color/switch_thumb"
        android:trackTint="@color/switch_track"/>

    <Switch
        android:id="@+id/switch_checkin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="日历打卡（完成今日目标后记录当日打卡）"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        android:thumbTint="@color/switch_thumb"
        android:trackTint="@color/switch_track"/>

    <TextView
        android:id="@+id/tv_checkin_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/home_text_secondary"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"/>

    <Switch
        android:id="@+id/switch_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="复习计时（页头显示总时长与本题用时）"
        android:textSize="18sp"
        android:layout_marginTop="30dp"
        android:thumbTint="@color/switch_thumb"
        android:trackTint="@color/switch_track"/>

    <TextView
        android:id="@+id/tv_budget_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="每日复习量：50 题/天"
        android:textSize="18sp"
        android:layout_marginTop="30dp"
        android:padding="8dp"/>

</LinearLayout>