<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 固定浅色主题：全应用为纯浅色设计，避免系统深色把系统控件（搜索框/列表弹窗）染黑 -->
    <style name="Base.Theme.Demo" parent="Theme.Material3.Light.NoActionBar">
        <!-- 状态栏与导航栏跟随页底，图标转深色，避免露出 Material3 默认紫 -->
        <item name="android:statusBarColor">@color/home_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/home_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.Demo" parent="Base.Theme.Demo" />

    <!-- 全应用统一顶栏：白底 56dp + 4dp 投影，左侧返回箭头 + 居中 18sp 粗体标题 -->
    <style name="TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/home_card</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- 顶栏叠层版：用于右侧动作宽度不等的页面（题库列表/题库管理），标题居中于整栏 -->
    <style name="TopBarOverlay">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@color/home_card</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- 顶栏左侧返回：56dp 宽热区，「←」= 展示档 20sp 深灰 -->
    <style name="TopBarBack">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:text">←</item>
        <item name="android:textSize">@dimen/text_size_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- 顶栏标题：占满剩余宽度、居中、标题档 18sp 粗体 -->
    <style name="TopBarTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 图片编辑页：与详情页同一套浅底，状态栏与导航栏同色、图标转深色 -->
    <style name="Theme.Demo.ImageEdit" parent="Theme.Demo">
        <item name="android:windowBackground">@color/edit_bg</item>
        <item name="android:statusBarColor">@color/edit_bg</item>
        <item name="android:navigationBarColor">@color/edit_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- 编辑页工具条按钮：三格等分、46dp 高、图标配文字（沿用详情页按钮的尺寸与圆角） -->
    <style name="ImageEditBarButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 工具条按钮里的图标：20dp，与文字间距 8dp -->
    <style name="ImageEditBarIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <!-- 工具条按钮里的文字：强调档 16sp，颜色在布局里按主/次分别指定 -->
    <style name="ImageEditBarText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_emphasis</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
