<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="switch_thumb">#FFFFFF</color>
    <color name="switch_thumb_disabled">#BDBDBD</color>
    <color name="switch_track">@color/action_primary</color>
    <color name="switch_track_disabled">@color/divider</color>

    <!-- 全应用统一：灰阶三档（主文/次文/提示）+ 分隔线 -->
    <color name="text_primary">#222222</color>
    <color name="text_secondary">#616161</color>
    <color name="text_hint">#999999</color>
    <color name="divider">#E0E0E0</color>

    <!-- 全应用统一：页底与主操作色 -->
    <color name="page_bg">#F0F2F5</color>
    <!-- 主操作（按钮底、开关、选中描边、进度）：沿用品牌浅蓝 -->
    <color name="action_primary">#5D9CEC</color>

    <!-- 语义色：填充用基础色，文字/描边/图标用加深档，保证白底可读 -->
    <color name="state_success">#52C41A</color>
    <color name="state_success_text">#389E0D</color>
    <color name="state_warn">#FAAD14</color>
    <color name="state_warn_text">#AD6800</color>
    <!-- 描边按钮用的橙色档：描边走浅档、文字图标走纯档，避免褐橙发脏 -->
    <color name="state_warn_stroke">#FFD591</color>
    <color name="state_warn_strong">#D46B08</color>
    <!-- 提示条底色：与警告文字配套的浅底 -->
    <color name="state_warn_bg">#FFF7E6</color>
    <color name="state_danger">#FF4D4F</color>
    <color name="state_danger_text">#CF1322</color>

    <!-- 弹窗次要按钮底色：浅蓝灰，配主色文字 -->
    <color name="dialog_secondary_bg">#E9EEF6</color>

    <!-- 详情页操作区 -->
    <color name="detail_primary">#1F6AA5</color>
    <color name="detail_secondary_stroke">#9E9E9E</color>
    <color name="favorite_gold">#FFB300</color>

    <!-- 图片编辑页：与其他页共用同一档页底 -->
    <color name="edit_bg">@color/page_bg</color>
    <color name="edit_stage_bg">#111111</color>

    <!-- 主页 -->
    <!-- 品牌浅蓝：仅用于图表等数据可视化，不再作按钮/顶栏底色 -->
    <color name="home_primary">#5D9CEC</color>
    <color name="home_bg">@color/page_bg</color>
    <color name="home_card">#FFFFFF</color>
    <color name="home_on_primary_secondary">#CCFFFFFF</color>
    <!-- 未来 7 天到期柱：非今天/非选中柱的淡主色 -->
    <color name="home_chart_bar">#E3EDFB</color>
</resources>
