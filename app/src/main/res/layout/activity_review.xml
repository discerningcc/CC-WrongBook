<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/session_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#fff7e6"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#ad6800" />

        <TextView
            android:id="@+id/btn_banner_new"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="开始新一轮"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1f6aa5"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_banner_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="×"
            android:textSize="18sp"
            android:textColor="#ad6800" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/question_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:layout_marginBottom="12dp">

        <!-- 🔥 给整个题目容器加id，用来绑定点击事件 -->
        <LinearLayout
            android:id="@+id/question_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 工具栏：左侧计时段（计时开关关闭时隐藏），右侧溢出菜单 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="0dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/timer_row"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true">

                    <ImageView
                        android:id="@+id/iv_timer_state"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#888888" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="⋮"
                    android:textSize="14sp"
                    android:textColor="#1f6aa5" />
            </LinearLayout>

            <!-- 工具栏与正文分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#eeeeee"
                android:layout_marginBottom="12dp" />

            <!-- 元信息行：等级药丸 + 完成进度；ID 收进溢出菜单 -->
            <LinearLayout
                android:id="@+id/meta_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_level_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_level_badge"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff" />

                <TextView
                    android:id="@+id/tv_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textSize="12sp"
                    android:textColor="#999999" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#222222"
                android:lineSpacingExtra="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/review_image_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"/>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/answer_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="24dp"
                android:paddingTop="16dp"
                android:background="#f8f8f8">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="【答案】"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1f6aa5"/>

                <TextView
                    android:id="@+id/tv_answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="#333333"
                    android:layout_marginTop="8dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:id="@+id/answer_image_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp"/>
                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_know"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#52c41a">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="记得"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_unknown"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#faad14">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="模糊"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_forget"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#ff4d4f">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="不会"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_answer"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#1f6aa5">

            <TextView
                android:id="@+id/btn_answer_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="答案"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
